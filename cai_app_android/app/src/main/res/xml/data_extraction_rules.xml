<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir datos de autenticación sensibles del backup en la nube -->
        <exclude domain="sharedpref" path="supabase_session.xml"/>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Excluir sesiones al transferir dispositivos; el usuario debe re-autenticarse -->
        <exclude domain="sharedpref" path="supabase_session.xml"/>
    </device-transfer>
</data-extraction-rules>